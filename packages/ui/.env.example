# The active testnet deployment is pinned in src/governance/deployment.ts.
# No private keys, subgraph, pinning or backend credentials are needed.
NEXT_PUBLIC_RPC_URL=https://testnet.rpc.intuition.systems/http

# Optional. Leave unset to use injected browser wallets only.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional discovery/history API. Development defaults to this local address.
# Production stays RPC-only unless explicitly configured. Set blank to disable.
# Use a public HTTPS indexer URL for a hosted app, not a visitor's localhost.
NEXT_PUBLIC_GOVERNANCE_INDEXER_URL=http://127.0.0.1:42069
