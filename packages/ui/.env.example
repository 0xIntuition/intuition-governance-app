# Both deployments are pinned in src/governance/deployment.ts. The build needs no variables.
# No private keys, subgraph, pinning or backend credentials are needed.
#
# Every NEXT_PUBLIC_* value is inlined into the public JavaScript at build time.
# Never put an API key or other secret in one. Leave NEXT_PUBLIC_ETHERSCAN_API_KEY,
# NEXT_PUBLIC_ALCHEMY_API_KEY and the upstream Taiko variables unset.

# Optional. "testnet" builds for Intuition testnet (chain 13579); anything else builds for mainnet (chain 1155).
NEXT_PUBLIC_GOVERNANCE_NETWORK=

# Optional. Overrides the public RPC of the selected deployment.
NEXT_PUBLIC_RPC_URL=

# Optional. Leave unset to use injected browser wallets only.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
